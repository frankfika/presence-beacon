# 在岗哨 · 环境变量示例
# 复制成 .env 后按需修改。启动时会自动读取同目录的 .env 文件。

# ── 服务 ──────────────────────────────────────────────
PORT=8080
# 0.0.0.0 = 允许局域网内其他设备访问（旧安卓机、员工手机都要连它）
# 只在本机用就改成 127.0.0.1
HOST=0.0.0.0

# 数据文件位置（Docker 里用挂载的卷）
DB_FILE=./data/presence.db

# ── WebAuthn（指纹 / Face ID）────────────────────────────
# RP_ID：裸域名，不带 https://、不带端口、不带路径
#   ✅ pb.example.com
#   ❌ https://pb.example.com
#   ❌ pb.example.com:8443
# 如果只在 localhost 上跑，本地开发用 localhost 即可
RP_ID=localhost

# APP_ORIGIN：浏览器地址栏里那个地址，一字不差
# 多个用英文逗号分隔
#   ✅ https://pb.example.com
#   ❌ https://pb.example.com/     ← 末尾不能有斜杠
APP_ORIGIN=http://localhost:8080

# 显示在系统弹窗里的名字
RP_NAME=在岗哨

# ── 管理员 ─────────────────────────────────────────────
# 留空则首次启动自动生成，写在 data/.admin-password 文件里
# 想自己指定就填一个至少 12 位的随机口令
# ADMIN_PASSWORD=请改成你自己的强口令

# ── 其他 ───────────────────────────────────────────────
# 中国是 UTC+8 = 480
TZ_OFFSET_MINUTES=480

# 二维码有效期（秒）。太短员工来不及扫，太长则二维码被截图重放的风险变高
SESSION_TTL_SECONDS=45

# 周报自动推送地址（可选）。留空则只在管理端手动导出
# REPORT_WEBHOOK_URL=https://example.com/your/webhook
# REPORT_PUSH_HOUR=9

# 如果你的服务在 Nginx / Caddy 后面，并且确认反代会覆盖 X-Forwarded-For，
# 才把它设成 1。默认不信任任何客户端传来的 XFF（否则限流可被绕过）。
# TRUST_PROXY=1
